											"});\r",
											"\r",
											"const jsonData = pm.response.json();\r",
											"\r",
											"pm.test(\"Code is 0\", function () {\r",
											"    pm.expect(jsonData.code).to.equal(0);\r",
											"});\r",
											"\r",
											"pm.test(\"Nonce exists\", function () {\r",
											"    pm.expect(jsonData.data.nonce).to.be.a('string');\r",
											"});\r",
