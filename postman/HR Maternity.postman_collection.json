											"pm.environment.set(\"rsa_modulus\", jsonData.data.modulus);\r",
											"pm.environment.set(\"rsa_exponent\", jsonData.data.exponent);\r",
											"\r",
											"console.log(\"✅ RSA Public Key saved\");\r",
											"console.log(\"  - modulus:\", jsonData.data.modulus.substring(0, 30) + \"...\");\r",
											"console.log(\"  - exponent:\", jsonData.data.exponent);"
