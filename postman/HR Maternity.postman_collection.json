				{
					"name": "产假津贴 (Maternity Allowance)",
					"item": [
						{
							"name": "Calculate Maternity Allowance - SH Case1",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json",
										"type": "text"
									},
									{
										"key": "Accept",
										"value": "application/json",
										"type": "text"
									},
									{
										"key": "x-acc-op",
										"value": "{{auth}}",
										"type": "text"
									}
								],
